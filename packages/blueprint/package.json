{
  "name": "dsh-blueprint",
  "version": "0.1.0",
  "description": "See and validate a DeepSeek Harness overlay before you apply it: a Harness Map tab for the web client.",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "cordis",
    "gui"
  ],
  "license": "MIT",
  "author": "talosteam",
  "homepage": "https://github.com/taltara/mddl-harness/tree/main/packages/blueprint#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taltara/mddl-harness.git",
    "directory": "packages/blueprint"
  },
  "bugs": {
    "url": "https://github.com/taltara/mddl-harness/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "files": [
    "cordis.patch.yml",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@mddl/compiler": "workspace:*",
    "@mddl/graph-schema": "workspace:*",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.8",
    "@types/react": "^18.3.1",
    "react": "^18.2.0",
    "tsdown": "^0.15.6",
    "typescript": "^5.9.2"
  }
}
